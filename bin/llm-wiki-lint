#!/usr/bin/env bash
# llm-wiki-lint — mechanical consistency checks for the LLM-WIKI bundle.
#
# FAIL (exit 1): frontmatter violations, git-tracked binaries/raw dumps,
#                index coverage gaps, directory links (Obsidian cannot open
#                a link whose target is a folder — link its index.md).
# warn (exit 0): broken relative links, .md filenames with spaces,
#                commit prefixes not matching a documented instance_id,
#                stale next.md / state snapshot.
#
# Runbook: LLM-WIKI/runbooks/wiki-lint.md
set -uo pipefail

SCOPE=tracked
case "${1:-}" in
  ""|--tracked) ;;
  --working-tree) SCOPE=working-tree ;;
  -h|--help)
    echo "Usage: llm-wiki-lint [--tracked|--working-tree]"
    echo "Reads working-tree contents of tracked paths (default), or also non-ignored untracked paths."
    exit 0 ;;
  *) echo "llm-wiki-lint: unknown option: $1" >&2; exit 64 ;;
esac
[[ $# -le 1 ]] || { echo "llm-wiki-lint: too many arguments" >&2; exit 64; }

list_files() {
  if [[ "$SCOPE" == working-tree ]]; then
    git -c core.quotepath=off ls-files --cached --others --exclude-standard "$@" | sort -u
  else
    git -c core.quotepath=off ls-files "$@"
  fi
}

# Minimal scalar reader, not a general YAML parser. Existing simple metadata
# remains valid; complex/external redirect targets are reviewed manually.
frontmatter_value() {
  awk -v key="$2" 'NR==1 {if ($0 != "---") exit; next}
    /^---[[:space:]]*$/ {exit}
    index($0, key ":") == 1 {sub(/^[^:]*:[[:space:]]*/, "");
      sub(/[[:space:]]+$/, ""); print; exit}' "$1" 2>/dev/null
}
is_redirect() {
  [[ "$(frontmatter_value "$1" type)" == Redirect ]]
}

resolve_wiki_dir() {
  if [[ -n "${LLM_WIKI_DIR:-}" ]]; then
    printf '%s\n' "$LLM_WIKI_DIR"
    return 0
  fi
  local candidates=(
    "$HOME/Documents/Obsidian Vault/LLM-WIKI"
    "$HOME/llm-wiki"
    "$HOME/obsidian-vault/LLM-WIKI"
  )
  local candidate
  for candidate in "${candidates[@]}"; do
    if [[ -e "$candidate/.git" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

WIKI_DIR="$(resolve_wiki_dir || true)"
if [[ -z "$WIKI_DIR" || ! -d "$WIKI_DIR" ]]; then
  echo "llm-wiki-lint: LLM-WIKI directory not found (set LLM_WIKI_DIR)" >&2
  exit 2
fi
cd "$WIKI_DIR"

FAILS=0
WARNS=0
emit() { # emit <fail|warn> <message-lines-variable-content>
  local level="$1" lines="$2" line
  [[ -z "$lines" ]] && return 0
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    if [[ "$level" == fail ]]; then
      echo "FAIL: $line"; FAILS=$((FAILS + 1))
    else
      echo "warn: $line"; WARNS=$((WARNS + 1))
    fi
  done <<< "$lines"
}

reserved_basename() {
  case "$1" in
    index.md|log.md|AGENTS.md|CLAUDE.md|README.md) return 0 ;;
    *) return 1 ;;
  esac
}

echo "== llm-wiki-lint: $WIKI_DIR (scope: $SCOPE)"

# 1. Frontmatter: every tracked non-reserved .md needs '---' + non-empty type:
FRONTMATTER=$(list_files '*.md' | while IFS= read -r f; do
  [[ -f "$f" ]] || { echo "tracked path missing from working tree: $f"; continue; }
  reserved_basename "$(basename "$f")" && continue
  if [[ "$(head -1 "$f")" != "---" ]]; then
    echo "frontmatter missing: $f"
    continue
  fi
  awk 'NR==1{next} /^---[[:space:]]*$/{exit 1} /^type:[[:space:]]*[^[:space:]]/{found=1; exit 0} END{exit found?0:1}' "$f" \
    || echo "frontmatter has no type: $f"
done)
emit fail "$FRONTMATTER"

# 2. Git-tracked binaries / raw-dump directories
BINARIES=$( { list_files | grep -Ei '\.(pdf|hwp|hwpx|doc|docx|ppt|pptx|xls|xlsx|zip)$' || true; } \
  | sed 's/^/binary tracked by git (belongs in vault sources\/): /')
emit fail "$BINARIES"
DUMPS=$( { list_files | grep -E '(^|/)(PDFs|extracted)/|/papers/pdf/' || true; } \
  | sed 's/^/raw-dump path tracked by git: /')
emit fail "$DUMPS"

# 3. Index coverage: in each directory that has an index.md, every non-reserved
#    tracked sibling .md and every child directory must be mentioned by name.
COVERAGE=$(list_files '*index.md' | sed 's|/index.md$||; s|^index.md$|.|' | sort -u | while IFS= read -r dir; do
  idx="$dir/index.md"
  [[ -f "$idx" ]] || continue
  list_files "$dir/*.md" | while IFS= read -r f; do
    [[ "$(dirname "$f")" == "$dir" ]] || continue
    base=$(basename "$f")
    reserved_basename "$base" && continue
    is_redirect "$f" && continue
    grep -qF "${base%.md}" "$idx" || echo "not in $idx: $base"
  done
  list_files "$dir/*" | while IFS= read -r f; do
    rel="${f#"$dir"/}"
    child="${rel%%/*}"
    [[ "$rel" == "$child" ]] && continue
    [[ "$child" == _* || "$child" == .* ]] && continue
    echo "$child"
  done | sort -u | while IFS= read -r child; do
    is_redirect "$dir/$child/index.md" && continue
    grep -qF "$child" "$idx" || echo "not in $idx: $child/"
  done
done)
emit fail "$COVERAGE"

# Retired documents need a destination, not a restored active-project index.
# redirect_to is a wiki-root (/...) or file-relative path. Legacy prose and
# destinations outside this bundle stay visible as manual-review warnings.
REDIRECTS=$(list_files '*.md' | while IFS= read -r f; do
  is_redirect "$f" || continue
  target="$(frontmatter_value "$f" redirect_to)"
  if [[ -z "$target" || "$target" == *://* || "$target" == ../..* ]]; then
    echo "redirect target needs manual review: $f"
    continue
  fi
  if [[ "$target" == /* ]]; then
    resolved=".${target}"
  else
    resolved="$(dirname "$f")/$target"
  fi
  [[ -f "$resolved" ]] || echo "missing redirect target: $f -> $target"
done)
emit fail "$(grep '^missing redirect target:' <<< "$REDIRECTS" || true)"
emit warn "$(grep '^redirect target needs manual review:' <<< "$REDIRECTS" || true)"

# 4. Relative markdown link targets.
#    - target is a directory -> FAIL: Obsidian cannot open folder links;
#      the link must point at the folder's index.md (or another file).
#    - target missing -> warn (OKF tolerates intentional not-yet-written
#      knowledge, but list them).
LINKS=$(list_files '*.md' | while IFS= read -r f; do
  # fenced code blocks and inline code spans are documentation examples, not links
  sed '/^```/,/^```/d; s/`[^`]*`//g' "$f" 2>/dev/null \
    | grep -oE '\]\(([^)#][^)]*)\)' | sed -E 's/^\]\(//; s/\)$//' | while IFS= read -r target; do
    [[ "$target" == http://* || "$target" == https://* || "$target" == mailto:* || "$target" == ssh://* || "$target" == file://* ]] && continue
    target="${target%%#*}"
    [[ -z "$target" ]] && continue
    # citation-style prose like "[29](설명)" is not a link: skip targets with
    # literal spaces or without any path character (/ or .); real links to
    # spaced filenames use %20 (decoded below)
    [[ "$target" == *" "* ]] && continue
    [[ "$target" != */* && "$target" != *.* ]] && continue
    target="${target//%20/ }"
    if [[ "$target" == /* ]]; then
      resolved=".${target}"
    else
      resolved="$(dirname "$f")/${target}"
    fi
    if [[ -d "$resolved" ]]; then
      echo "directory link (Obsidian cannot open folder links; link ${target%/}/index.md instead): $f -> $target"
    elif [[ ! -e "$resolved" ]]; then
      if [[ "$target" == LLM-WIKI/* && -f "./${target#LLM-WIKI/}" ]]; then
        echo "vault-root link needs Git-only translation: $f -> $target"
      elif [[ "$target" == LLM-WIKI/* && -d "./${target#LLM-WIKI/}" ]]; then
        echo "directory link (vault root; link its index.md): $f -> $target"
      else
        echo "broken link in $f -> $target"
      fi
    fi
  done
done | sort -u)
DIRLINKS=$(grep '^directory link' <<< "$LINKS" || true)
BROKENLINKS=$(grep -v '^directory link' <<< "$LINKS" || true)
emit fail "$DIRLINKS"
emit warn "$BROKENLINKS"

# 5. Concept .md filenames with spaces (kebab-case convention)
SPACES=$( { list_files '*.md' | grep ' ' || true; } | sed 's/^/filename has spaces (kebab-case preferred): /')
emit warn "$SPACES"

# 6. Recent commit subjects should start with a documented instance_id
IDS=$(grep -h '^instance_id:' instances/*.md 2>/dev/null | sed 's/^instance_id:[[:space:]]*//' | tr '\n' '|' | sed 's/|$//')
if [[ -n "$IDS" ]]; then
  PREFIXES=$(git log -15 --no-merges --format='%s' | while IFS= read -r subj; do
    echo "$subj" | grep -qE "^(${IDS}): " || echo "commit prefix is not a documented instance_id: '$subj'"
  done)
  emit warn "$PREFIXES"
fi

# 7b. Lifecycle review triggers (OKF-X dogfood): a doc declaring
#     lifecycle.review_when.age_days warns once untouched past that window
REVIEW=$(list_files '*.md' | while IFS= read -r f; do
  days=$(awk 'BEGIN{fm=0} /^---[[:space:]]*$/{fm++; next} fm==1 && /age_days:/ {gsub(/[^0-9]/,""); print; exit} fm>=2{exit}' "$f")
  [[ -z "$days" ]] && continue
  last=$(git log -1 --format=%ct -- "$f" 2>/dev/null)
  [[ -z "$last" ]] && continue
  age=$(( ($(date +%s) - last) / 86400 ))
  [[ "$age" -gt "$days" ]] && echo "lifecycle review due (${age}d since last touch, threshold ${days}d): $f"
done)
emit warn "$REVIEW"

# 7. Staleness hints (45 days since last commit touching the file)
NOW=$(date +%s)
STALE=$(list_files '*.md' | while IFS= read -r p; do
  [[ "$p" == */next.md || "$p" == state/current.md ]] || continue
  [[ -f "$p" ]] || continue
  last=$(git log -1 --format=%ct -- "$p" 2>/dev/null)
  [[ -z "$last" ]] && continue
  age_days=$(( (NOW - last) / 86400 ))
  [[ "$age_days" -gt 45 ]] && echo "stale (${age_days}d since last commit): $p"
done)
emit warn "$STALE"

echo "== result: ${FAILS} fail, ${WARNS} warn"
[[ "$FAILS" -eq 0 ]] || exit 1
exit 0
