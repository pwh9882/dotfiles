Host *
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist yes

  # 연결 시도 타임아웃 (기본 ~75초 → 120초)
  ConnectTimeout 120

  # Keepalive: 20초마다 신호 전송, 3회 무응답 시 끊김 (최대 1분 유휴 허용)
  # 죽은 연결을 오래 붙들면 로컬 셸 프롬프트가 그만큼 늦게 돌아오고, 원격
  # tmux가 남긴 mouse/focus 리포팅 모드를 정리하는 precmd도 같이 늦어진다.
  # 세션은 원격 tmux에 남으므로 일찍 끊겨도 재접속뿐이다.
  ServerAliveInterval 20
  ServerAliveCountMax 3

  # ForwardAgent: 로컬 Bitwarden SSH agent를 원격 서버로 포워딩
  # 접속하는 머신에 Bitwarden Desktop이 켜져있으면 자동으로 agent 전달
  # 신뢰하는 서버에만 사용할 것 (악의적 서버가 agent를 악용할 수 있음)
  # ForwardAgent yes
