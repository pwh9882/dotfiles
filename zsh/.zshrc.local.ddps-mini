# ============================================================
# Machine-specific config for: ddps-mini
# ============================================================

# ---- Conda / Miniforge ----
__conda_setup="$('$HOME/miniforge3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "$HOME/miniforge3/etc/profile.d/conda.sh" ]; then
        . "$HOME/miniforge3/etc/profile.d/conda.sh"
    else
        export PATH="$HOME/miniforge3/bin:$PATH"
    fi
fi
unset __conda_setup

# ---- Flutter ----
export PATH="$PATH:$HOME/development/flutter/bin"

# ---- Remote Dev (VS Code SSH) ----
cods() {
    local remote_path=${1:-"/home/ubuntu/"}
    code --folder-uri "vscode-remote://ssh-remote+normalize.duckdns.org$remote_path"
}

# ---- Google Drive shortcut ----
alias gd="cd '$HOME/Library/CloudStorage/GoogleDrive-pwh9882@gmail.com/내 드라이브'"

# ---- Machine-specific settings ----
ulimit -n 1048575
DEFAULT_USER=woohyeok
export AWS_PROFILE=spotrank

alias moltbot="clawdbot"
